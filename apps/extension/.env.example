# Server URL the extension talks to (REST API + Socket.IO signaling).
# Must be prefixed WXT_ or VITE_ to be exposed to the built extension bundle.
# For local development against `pnpm --filter @bol-bhai/server dev`:
WXT_API_BASE_URL=http://localhost:4000

# For a production build, copy this to .env.production with your deployed,
# HTTPS server URL instead, e.g.:
# WXT_API_BASE_URL=https://bol-bhai-server.onrender.com

# Optional TURN relay, only needed for peers behind symmetric NATs / restrictive
# firewalls that STUN alone cannot traverse. Leave unset to use STUN only.
# WXT_TURN_URL=turn:your-turn-host:3478
# WXT_TURN_USERNAME=
# WXT_TURN_CREDENTIAL=

