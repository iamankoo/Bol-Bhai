PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated allowlist for both the REST API and Socket.IO. Leave unset to
# allow any origin (needed in practice because a chrome-extension://<id> origin
# varies per install unless the extension is published with a pinned key).
# Example once the extension is published: CORS_ALLOWED_ORIGINS=chrome-extension://<published-id>
CORS_ALLOWED_ORIGINS=
