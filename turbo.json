{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"],
      "env": ["WXT_API_BASE_URL", "WXT_TURN_URL", "WXT_TURN_USERNAME", "WXT_TURN_CREDENTIAL"]
    },
    "@bol-bhai/extension#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"],
      "env": ["WXT_API_BASE_URL", "WXT_TURN_URL", "WXT_TURN_USERNAME", "WXT_TURN_CREDENTIAL"],
      "inputs": ["$TURBO_DEFAULT$", ".env.production", ".env.production.local", ".env.local"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
